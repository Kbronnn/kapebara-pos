# Copy this file to .env and fill in your values
# NEVER commit .env to Git

# MongoDB Atlas connection string (get this from atlas.mongodb.com)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/kapebara?retryWrites=true&w=majority

# Port (leave blank — Render sets this automatically)
PORT=3000

# Cloudinary — persistent image storage (get from cloudinary.com → Dashboard)
# Images uploaded in the Menu manager are stored here so they survive server restarts.
CLOUDINARY_CLOUD_NAME=<your_cloud_name>
CLOUDINARY_API_KEY=<your_api_key>
CLOUDINARY_API_SECRET=<your_api_secret>
